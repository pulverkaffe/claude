# beehiiv API Configuration
# Copy this file to .env and fill in your actual values

# Your beehiiv API key (get this from Settings > API in beehiiv)
BEEHIIV_API_KEY=your_api_key_here

# Your beehiiv Publication ID (found in Settings > API in beehiiv)
BEEHIIV_PUBLICATION_ID=your_publication_id_here

# Directory containing your Markdown files to import
POSTS_DIRECTORY=./posts

# Set to true to test without actually creating posts
DRY_RUN=false

# Delay in seconds between API requests (to avoid rate limiting)
DELAY_BETWEEN_POSTS=2
